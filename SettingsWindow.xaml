<Window x:Class="Stacks.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="480" Height="620"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">

    <Window.Resources>
        <!-- Modern Fluent color palette -->
        <Color x:Key="CardBg">#F3FFFFFF</Color>
        <Color x:Key="CardBorder">#1A000000</Color>
        <Color x:Key="AccentColor">#FF0078D4</Color>
        <SolidColorBrush x:Key="TextPrimary" Color="#DD000000"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#99000000"/>
        <Color x:Key="ToggleOn">#FF0078D4</Color>
        <Color x:Key="ToggleOff">#FFB4B4B4</Color>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="24,16,0,8"/>
        </Style>

        <!-- Label text -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Sub-label / description -->
        <Style x:Key="DescStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ComboBox style -->
        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource AccentColor}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FF1084D0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FF005A9E"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (remove folder) — no hover trigger to avoid XAML parsing issues -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#33FF4444"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Folder item in ListBox -->
        <DataTemplate x:Key="FolderItemTemplate">
            <Border CornerRadius="6" Background="#0A000000" Padding="10,8" Margin="0,3">
                <DockPanel>
                    <TextBlock Text="{Binding .}" FontFamily="Microsoft YaHei UI" FontSize="12"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" DockPanel.Dock="Left"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="✕" Style="{DynamicResource DangerButton}"
                            Click="RemoveFolder_Click" Tag="{Binding .}"
                            HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Root: rounded card with drop shadow -->
    <Border CornerRadius="14" BorderBrush="#20000000" BorderThickness="1"
            ClipToBounds="True" MouseLeftButtonDown="OnDragMove">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="8" BlurRadius="24" Opacity="0.25" Direction="270" Color="Black"/>
        </Border.Effect>
        <Border.Background>
            <SolidColorBrush Color="{StaticResource CardBg}"/>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Title bar ═══ -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="#FFF8F8F8"
                    Padding="20,14" MouseLeftButtonDown="OnDragMove">
                <Grid>
                    <TextBlock Text="⚙ 设置" FontFamily="Microsoft YaHei UI" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0" FontSize="14"
                            Foreground="{StaticResource TextSecondary}" Cursor="Hand"
                            Padding="8,4" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- ═══ Scrollable content ═══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,4">

                <StackPanel>

                    <!-- ── Section: Classification Sources ── -->
                    <TextBlock Text="分类源" Style="{StaticResource SectionHeader}"/>

                    <Border CornerRadius="10" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" Padding="20,14" Margin="16,0,16,10">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource CardBg}"/>
                        </Border.Background>
                        <StackPanel>
                            <!-- Desktop toggle -->
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <StackPanel>
                                    <TextBlock Text="分类桌面" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="将桌面文件纳入叠放分类" Style="{StaticResource DescStyle}"/>
                                </StackPanel>
                                <Border x:Name="DesktopToggle" CornerRadius="12" Width="42" Height="22"
                                        Background="{StaticResource ToggleOff}" Cursor="Hand"
                                        MouseLeftButtonDown="DesktopToggle_Click" HorizontalAlignment="Right"
                                        Margin="12,0,0,0">
                                    <Ellipse x:Name="DesktopThumb" Fill="White" Width="18" Height="18"
                                             HorizontalAlignment="Left" Margin="2,0,0,0"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="0" Y="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </StackPanel>

                            <Separator Margin="0,10" Background="#1A000000"/>

                            <!-- Folders section -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="分类文件夹" Style="{StaticResource LabelStyle}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="+ 添加文件夹" Style="{StaticResource ModernButton}"
                                            FontSize="11" Padding="10,5" Margin="12,0,0,0"
                                            Click="AddFolder_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="添加要参与分类的文件夹（可多个）" Style="{StaticResource DescStyle}"/>

                                <!-- Folder list -->
                                <ListBox x:Name="FolderList" ItemsSource="{Binding}"
                                         ItemTemplate="{DynamicResource FolderItemTemplate}"
                                         BorderThickness="0" Background="Transparent"
                                         MaxHeight="140" Margin="0,8,0,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Section: Grouping & Layout ── -->
                    <TextBlock Text="分组与布局" Style="{StaticResource SectionHeader}"/>

                    <Border CornerRadius="10" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" Padding="20,14" Margin="16,0,16,10">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource CardBg}"/>
                        </Border.Background>
                        <StackPanel>
                            <!-- Group mode -->
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="分组方式" Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="GroupModeCombo" Style="{StaticResource ModernCombo}"
                                          SelectionChanged="GroupModeCombo_SelectionChanged"
                                          Margin="12,0,0,0">
                                    <ComboBoxItem Content="按类型" Tag="kind" IsSelected="True"/>
                                    <ComboBoxItem Content="按日期" Tag="date"/>
                                    <ComboBoxItem Content="不分组" Tag="none"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Layout -->
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="展开布局" Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="LayoutCombo" Style="{StaticResource ModernCombo}"
                                          SelectionChanged="LayoutCombo_SelectionChanged"
                                          Margin="12,0,0,0">
                                    <ComboBoxItem Content="网格" Tag="grid" IsSelected="True"/>
                                    <ComboBoxItem Content="扇形" Tag="fan"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Sort mode -->
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="排序方式" Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="SortModeCombo" Style="{StaticResource ModernCombo}"
                                          SelectionChanged="SortModeCombo_SelectionChanged"
                                          Margin="12,0,0,0">
                                    <ComboBoxItem Content="按名称" Tag="name" IsSelected="True"/>
                                    <ComboBoxItem Content="按日期" Tag="date"/>
                                    <ComboBoxItem Content="按大小" Tag="size"/>
                                    <ComboBoxItem Content="按类型" Tag="type"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Section: Display Options ── -->
                    <TextBlock Text="显示选项" Style="{StaticResource SectionHeader}"/>

                    <Border CornerRadius="10" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" Padding="20,14" Margin="16,0,16,10">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource CardBg}"/>
                        </Border.Background>
                        <StackPanel>
                            <!-- Hide apps toggle -->
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <StackPanel>
                                    <TextBlock Text="隐藏应用" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="隐藏「应用」类型的叠放组" Style="{StaticResource DescStyle}"/>
                                </StackPanel>
                                <Border x:Name="HideAppsToggle" CornerRadius="12" Width="42" Height="22"
                                        Background="{StaticResource ToggleOff}" Cursor="Hand"
                                        MouseLeftButtonDown="HideAppsToggle_Click" HorizontalAlignment="Right"
                                        Margin="12,0,0,0">
                                    <Ellipse x:Name="HideAppsThumb" Fill="White" Width="18" Height="18"
                                             HorizontalAlignment="Left" Margin="2,0,0,0"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="0" Y="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </StackPanel>

                            <!-- Auto-start toggle -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="开机自启动" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="登录 Windows 时自动运行 Stacks" Style="{StaticResource DescStyle}"/>
                                </StackPanel>
                                <Border x:Name="AutoStartToggle" CornerRadius="12" Width="42" Height="22"
                                        Background="{StaticResource ToggleOff}" Cursor="Hand"
                                        MouseLeftButtonDown="AutoStartToggle_Click" HorizontalAlignment="Right"
                                        Margin="12,0,0,0">
                                    <Ellipse x:Name="AutoStartThumb" Fill="White" Width="18" Height="18"
                                             HorizontalAlignment="Left" Margin="2,0,0,0"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="0" Y="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Refresh button -->
                    <Button Content="🔄 刷新文件列表" Style="{StaticResource ModernButton}"
                            HorizontalAlignment="Stretch" Margin="16,12,16,4"
                            Padding="0,10" Click="Refresh_Click"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ Footer ═══ -->
            <Border Grid.Row="2" CornerRadius="0,0,14,14" Background="#FFF0F0F0"
                    Padding="20,12" BorderBrush="#15000000" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Stacks v1.0 · Windows 桌面叠放"
                               FontFamily="Microsoft YaHei UI" FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="完成" Style="{StaticResource ModernButton}" Padding="24,8"
                            Click="Close_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
