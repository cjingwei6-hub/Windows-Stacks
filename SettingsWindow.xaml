<Window x:Class="Stacks.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FFFFFFFF"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        Width="680" Height="520"
        WindowStartupLocation="CenterScreen"
        MinWidth="560" MinHeight="420"
        Loaded="OnLoaded">

    <Window.Resources>
        <!-- ═══ Colors ═══ -->
        <SolidColorBrush x:Key="BgMain" Color="#FFF5F5F5"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#FFEDEDED"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF1084D0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#DD1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#99555555"/>
        <SolidColorBrush x:Key="TextMuted" Color="#BB888888"/>
        <SolidColorBrush x:Key="BorderLight" Color="#1AE0E0E0"/>
        <SolidColorBrush x:Key="ToggleOn" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="ToggleOff" Color="#FFD0D0D0"/>
        <SolidColorBrush x:Key="DangerBg" Color="#33FF4444"/>
        <SolidColorBrush x:Key="DangerHover" Color="#55FF4444"/>

        <!-- ═══ Sidebar nav item style ═══ -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6,0,0,6"
                                Background="Transparent"
                                Padding="14,12"
                                Margin="4,2,0,2"
                                Cursor="Hand">
                            <DockPanel>
                                <TextBlock x:Name="iconTxt" FontSize="16" Width="24"
                                           TextAlignment="Center" VerticalAlignment="Center"
                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                <TextBlock x:Name="labelTxt" FontFamily="Microsoft YaHei UI"
                                           FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgCard}"/>
                                <Setter TargetName="iconTxt" Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter TargetName="labelTxt" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="labelTxt" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <!-- ═══ Setting row: label left, control right ═══ -->
        <Style x:Key="SettingRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="LabelTxt" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DescTxt" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- ═══ Custom dropdown button (replaces retro ComboBox) ═══ -->
        <Style x:Key="DropdownBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7,28,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path DockPanel.Dock="Right" HorizontalAlignment="Right"
                                      Margin="8,0,6,0" Data="M 0 0 L 5 5 L 10 0 Z"
                                      Fill="{StaticResource TextMuted}" Stretch="Uniform"
                                      Width="9" Height="5"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Dropdown popup (context menu) ═══ -->
        <Style x:Key="DropItem" TargetType="MenuItem">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ═══ Primary button ═══ -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Danger button (remove folder) ═══ -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource DangerBg}"/>
            <Setter Property="Foreground" Value="#CC3333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Toggle switch (Border + Ellipse child, styled via Tag) ═══ -->
        <Style x:Key="ToggleStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ToggleOff}"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="On">
                    <Setter Property="Background" Value="{StaticResource ToggleOn}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ Folder item template ═══ -->
        <DataTemplate x:Key="FolderItemTpl">
            <Border CornerRadius="5" Background="#0A000000" Padding="10,7" Margin="0,3">
                <DockPanel>
                    <TextBlock Text="{Binding .}" FontFamily="Microsoft YaHei UI" FontSize="12"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                               DockPanel.Dock="Left" TextTrimming="CharacterEllipsis"/>
                    <Button Content="✕" Style="{DynamicResource BtnDanger}"
                            Click="RemoveFolder_Click" Tag="{Binding .}"
                            HorizontalAlignment="Right" Padding="5,1"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ═══ Context menus for custom dropdowns (must live in Resources, NOT in visual tree) ═══ -->
        <ContextMenu x:Key="GroupModeMenu">
            <MenuItem Header="按类型" Tag="kind" Style="{DynamicResource DropItem}" Click="GroupModeItem_Click"/>
            <MenuItem Header="按日期" Tag="date" Style="{DynamicResource DropItem}" Click="GroupModeItem_Click"/>
            <MenuItem Header="不分组" Tag="none" Style="{DynamicResource DropItem}" Click="GroupModeItem_Click"/>
            <MenuItem Header="按自定义规则" Tag="custom" Style="{DynamicResource DropItem}" Click="GroupModeItem_Click"/>
        </ContextMenu>

        <ContextMenu x:Key="LayoutMenu">
            <MenuItem Header="网格" Tag="grid" Style="{DynamicResource DropItem}" Click="LayoutItem_Click"/>
            <MenuItem Header="扇形" Tag="fan" Style="{DynamicResource DropItem}" Click="LayoutItem_Click"/>
        </ContextMenu>

        <ContextMenu x:Key="SortModeMenu">
            <MenuItem Header="按名称" Tag="name" Style="{DynamicResource DropItem}" Click="SortModeItem_Click"/>
            <MenuItem Header="按日期" Tag="date" Style="{DynamicResource DropItem}" Click="SortModeItem_Click"/>
            <MenuItem Header="按大小" Tag="size" Style="{DynamicResource DropItem}" Click="SortModeItem_Click"/>
            <MenuItem Header="按类型" Tag="type" Style="{DynamicResource DropItem}" Click="SortModeItem_Click"/>
        </ContextMenu>

        <!-- ═══ Custom rule item template ═══ -->
        <DataTemplate x:Key="CustomRuleTpl">
            <Border CornerRadius="5" Background="#0A000000" Padding="10,7" Margin="0,3">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Name}" FontFamily="Microsoft YaHei UI" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button Content="✕ 删除" Style="{DynamicResource BtnDanger}"
                                Click="RemoveCustomRule_Click" Tag="{Binding Id}"
                                HorizontalAlignment="Right" Padding="6,2"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ExtensionsText}" FontFamily="Consolas"
                               FontSize="11" Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- ═══ Root grid: sidebar + content ═══ -->
    <Grid Background="{StaticResource BgMain}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ LEFT SIDEBAR ═══ -->
        <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,1,0" Background="{StaticResource BgSidebar}">
            <StackPanel Margin="0,16,0,12">

                <!-- App title in sidebar -->
                <StackPanel Orientation="Horizontal" Margin="16,0,12,18" Cursor="Hand"
                          MouseLeftButtonDown="OnDragMove">
                    <TextBlock Text="⚙" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text=" 设置" FontFamily="Microsoft YaHei UI" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <Separator Margin="16,14,12,14" Background="{StaticResource BorderLight}"/>

                <!-- Nav items -->
                <RadioButton GroupName="Nav" Style="{DynamicResource NavItem}"
                             Tag="sources" IsChecked="True" Click="Nav_Click"
                             Content="📁 分类源" ToolTip="选择要分类的桌面和文件夹"/>

                <RadioButton GroupName="Nav" Style="{DynamicResource NavItem}"
                             Tag="grouping" Click="Nav_Click"
                             Content="📊 分组与布局" ToolTip="分组方式、展开布局、排序"/>

                <RadioButton GroupName="Nav" Style="{DynamicResource NavItem}"
                             Tag="display" Click="Nav_Click"
                             Content="👁 显示选项" ToolTip="隐藏应用、开机自启"/>

                <RadioButton GroupName="Nav" Style="{DynamicResource NavItem}"
                             Tag="custom" Click="Nav_Click"
                             Content="📝 自定义" ToolTip="自定义叠放栏名称和分类规则"/>

                <!-- Spacer -->
                <Rectangle Height="1" Fill="Transparent" VerticalAlignment="Stretch"/>

                <!-- Version in sidebar bottom -->
                <TextBlock Text="Stacks v1.0" FontFamily="Microsoft YaHei UI" FontSize="10"
                           Foreground="{StaticResource TextMuted}" Margin="16,0,12,0"
                           VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>

        <!-- ═══ RIGHT CONTENT AREA ═══ -->
        <Border Grid.Row="0" Grid.Column="1">
            <Grid>
                <!-- ── Panel 1: Classification Sources ── -->
                <StackPanel x:Name="PanelSources" Visibility="Visible" Margin="24,20,24,12">
                    <TextBlock Text="分类源" FontFamily="Microsoft YaHei UI" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,16"/>

                    <!-- Desktop toggle row -->
                    <Border CornerRadius="8" Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            Padding="18,14" Margin="0,0,0,12">
                        <StackPanel Style="{DynamicResource SettingRow}">
                            <StackPanel>
                                <TextBlock Text="分类桌面" Style="{DynamicResource LabelTxt}"/>
                                <TextBlock Text="将桌面文件纳入叠放分类" Style="{DynamicResource DescTxt}"/>
                            </StackPanel>
                                <Border x:Name="DesktopToggle" Style="{DynamicResource ToggleStyle}" Tag="Off"
                                    MouseLeftButtonDown="DesktopToggle_Click" HorizontalAlignment="Right">
                                    <Ellipse Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                        </StackPanel>
                    </Border>

                    <!-- Folders card -->
                    <Border CornerRadius="8" Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            Padding="18,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="分类文件夹" Style="{DynamicResource LabelTxt}"/>
                                <Button Content="+ 添加文件夹" Style="{DynamicResource BtnPrimary}"
                                        Padding="10,5" FontSize="11" Margin="12,0,0,0"
                                        Click="AddFolder_Click" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="添加要参与分类的文件夹（可多个）" Style="{DynamicResource DescTxt}"/>

                            <!-- Folder list -->
                            <ListBox x:Name="FolderList" ItemsSource="{Binding}"
                                     ItemTemplate="{DynamicResource FolderItemTpl}"
                                     BorderThickness="0" Background="Transparent"
                                     MaxHeight="150" Margin="0,10,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Panel 2: Grouping & Layout ── -->
                <StackPanel x:Name="PanelGrouping" Visibility="Collapsed" Margin="24,20,24,12">
                    <TextBlock Text="分组与布局" FontFamily="Microsoft YaHei UI" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,16"/>

                    <Border CornerRadius="8" Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            Padding="18,14">
                        <StackPanel>
                            <!-- Group mode -->
                            <StackPanel Style="{DynamicResource SettingRow}">
                                <TextBlock Text="分组方式" Style="{DynamicResource LabelTxt}"/>
                                <Button x:Name="GroupModeBtn" Style="{DynamicResource DropdownBtn}"
                                        Content="按类型" Click="GroupModeBtn_Click"
                                        Tag="kind" Margin="12,0,0,0"/>
                            </StackPanel>

                            <!-- Layout -->
                            <StackPanel Style="{DynamicResource SettingRow}">
                                <TextBlock Text="展开布局" Style="{DynamicResource LabelTxt}"/>
                                <Button x:Name="LayoutBtn" Style="{DynamicResource DropdownBtn}"
                                        Content="网格" Click="LayoutBtn_Click"
                                        Tag="grid" Margin="12,0,0,0"/>
                            </StackPanel>

                            <!-- Sort mode -->
                            <StackPanel Style="{DynamicResource SettingRow}">
                                <TextBlock Text="排序方式" Style="{DynamicResource LabelTxt}"/>
                                <Button x:Name="SortModeBtn" Style="{DynamicResource DropdownBtn}"
                                        Content="按名称" Click="SortModeBtn_Click"
                                        Tag="name" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Panel 3: Display Options ── -->
                <StackPanel x:Name="PanelDisplay" Visibility="Collapsed" Margin="24,20,24,12">
                    <TextBlock Text="显示选项" FontFamily="Microsoft YaHei UI" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,16"/>

                    <Border CornerRadius="8" Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            Padding="18,14">
                        <StackPanel>
                            <!-- Hide apps toggle -->
                            <StackPanel Style="{DynamicResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Text="隐藏应用" Style="{DynamicResource LabelTxt}"/>
                                    <TextBlock Text="隐藏「应用」类型的叠放栏" Style="{DynamicResource DescTxt}"/>
                                </StackPanel>
                                <Border x:Name="HideAppsToggle" Style="{DynamicResource ToggleStyle}" Tag="Off"
                                        MouseLeftButtonDown="HideAppsToggle_Click" HorizontalAlignment="Right">
                                    <Ellipse Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                            </StackPanel>

                            <!-- Auto-start toggle -->
                            <StackPanel Style="{DynamicResource SettingRow}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="开机自启动" Style="{DynamicResource LabelTxt}"/>
                                    <TextBlock Text="登录 Windows 时自动运行 Stacks" Style="{DynamicResource DescTxt}"/>
                                </StackPanel>
                                <Border x:Name="AutoStartToggle" Style="{DynamicResource ToggleStyle}" Tag="Off"
                                        MouseLeftButtonDown="AutoStartToggle_Click" HorizontalAlignment="Right">
                                    <Ellipse Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Refresh button -->
                    <Button Content="🔄 刷新文件列表" Style="{DynamicResource BtnPrimary}"
                            HorizontalAlignment="Stretch" Margin="0,16,0,0"
                            Padding="0,11" Click="Refresh_Click"/>
                </StackPanel>

                <!-- ── Panel 4: Custom (Names + Rules) ── -->
                <StackPanel x:Name="PanelCustom" Visibility="Collapsed" Margin="24,20,24,12">
                    <TextBlock Text="自定义" FontFamily="Microsoft YaHei UI" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="重命名叠放栏、添加专属分类规则" Style="{DynamicResource DescTxt}"
                               Margin="0,0,0,14"/>

                    <!-- Section A: 叠放栏名称 -->
                    <Border CornerRadius="8" Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            Padding="18,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="叠放栏名称" FontFamily="Microsoft YaHei UI"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="留空 = 使用默认名称（如「图像」「文稿」）"
                                       Style="{DynamicResource DescTxt}" Margin="0,2,0,10"/>

                            <ItemsControl x:Name="GroupNameList" BorderThickness="0" Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="160">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Background="#0A000000" Padding="10,6" Margin="0,2">
                                            <DockPanel>
                                                <TextBlock Text="{Binding DefaultName}" FontFamily="Microsoft YaHei UI"
                                                           FontSize="12" Foreground="{StaticResource TextMuted}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                           DockPanel.Dock="Left" MinWidth="70"/>
                                                <TextBox x:Name="GroupNameInput" Tag="{Binding GroupKey}"
                                                         Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Background="White" BorderBrush="{StaticResource BorderLight}"
                                                         BorderThickness="1" Padding="6,3" FontSize="12"
                                                         MaxLength="20"
                                                         TextChanged="GroupNameInput_TextChanged"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Section B: 自定义分类规则 -->
                    <Border CornerRadius="8" Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="自定义分类规则" FontFamily="Microsoft YaHei UI"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="把任意扩展名归到专属叠放栏（如「工作资料」「设计素材」）"
                                       Style="{DynamicResource DescTxt}" Margin="0,2,0,10"/>

                            <ItemsControl x:Name="CustomRuleList" BorderThickness="0" Background="Transparent"
                                          ItemTemplate="{DynamicResource CustomRuleTpl}"
                                          MaxHeight="160" Margin="0,0,0,10"/>

                            <!-- Add row -->
                            <Border CornerRadius="5" Background="#100078D4" Padding="10,10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="名称" FontFamily="Microsoft YaHei UI" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   DockPanel.Dock="Left"/>
                                        <TextBox x:Name="NewRuleName" Background="White"
                                                 BorderBrush="{StaticResource BorderLight}"
                                                 BorderThickness="1" Padding="6,3" FontSize="12"
                                                 MaxLength="16"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock Text="扩展名" FontFamily="Microsoft YaHei UI" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   DockPanel.Dock="Left"/>
                                        <TextBox x:Name="NewRuleExts" Background="White"
                                                 BorderBrush="{StaticResource BorderLight}"
                                                 BorderThickness="1" Padding="6,3" FontSize="12"/>
                                    </DockPanel>
                                    <TextBlock Text="用英文逗号分隔，如: pdf, docx, xlsx"
                                               FontFamily="Microsoft YaHei UI" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,4,0,6"/>
                                    <Button Content="+ 添加规则" Style="{DynamicResource BtnPrimary}"
                                            HorizontalAlignment="Right" Padding="14,6"
                                            Click="AddCustomRule_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ FOOTER BAR ═══ -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0"
                Padding="16,10" MouseLeftButtonDown="OnDragMove">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="完成" Style="{DynamicResource BtnPrimary}" Padding="28,9"
                        Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
